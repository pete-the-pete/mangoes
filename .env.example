# Local development only. Staging and production get their Postgres variables
# injected by Vercel from the Neon integration (Preview + Production scopes) —
# there is no Development-scoped DATABASE_URL to `vercel env pull`, because local
# development points at the Docker Compose Postgres below.
DATABASE_URL=postgresql://mango:mango@localhost:5432/mango_tracker

# From the Clerk dashboard (see issue #3).
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Comma-separated gmail addresses bootstrapped as Super Admins.
SUPER_ADMIN_EMAILS=you@gmail.com
