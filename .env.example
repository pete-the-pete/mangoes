# Local-only values. Everything else comes from `vercel env pull`, which writes
# .env.local — don't duplicate those keys here, or the blank copy may shadow the
# real one.

# Local Postgres from docker-compose.yml. Deliberately has no Development-scoped
# value in Vercel: staging and production get Neon, local gets Docker.
DATABASE_URL=postgresql://mango:mango@localhost:5432/mango_tracker

# Comma-separated gmail addresses bootstrapped as Super Admins. Put your own
# here — an empty value means nobody is a Super Admin, which reads as a
# confusing lockout rather than an error.
SUPER_ADMIN_EMAILS=you@gmail.com
