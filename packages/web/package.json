{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run build --prefix ../core",
    "build": "next build",
    "seed": "tsx --env-file-if-exists=../../.env.dev --env-file-if-exists=../../.env scripts/seed-item-types.ts",
    "vercel-build": "npm run build --prefix ../core && npm run migrate --prefix ../core && npm run seed && npm run build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.8.0",
    "clsx": "^2.1.1",
    "core": "0.0.0",
    "idb": "^8.0.3",
    "motion": "^13.1.1",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
