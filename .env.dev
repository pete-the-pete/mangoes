# Checked-in local development defaults. Loaded directly by `npm run migrate`;
# nothing to copy. A gitignored `.env` overrides these, and a real shell
# variable beats both.
#
# Everything else comes from `vercel env pull`, which writes .env.local —
# don't duplicate those keys here, or the blank copy may shadow the real one.

# Local Postgres from docker-compose.yml. Deliberately has no Development-scoped
# value in Vercel: staging and production get Neon, local gets Docker.
DATABASE_URL=postgresql://mango:mango@localhost:5432/mango_tracker
